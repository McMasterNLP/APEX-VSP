# =============================================================================
# APEX — root `.env` for Docker Compose (copy to `.env` and fill in).
# =============================================================================
# This file consolidates the same variables documented in:
#   - backend/.env.example   (FastAPI / Pydantic settings)
#   - frontend/.env.example    (Vite build-time `VITE_*` vars)
#
# Docker Compose reads `.env` from the repository root for `env_file:` and for
# frontend build args. Do not commit real secrets.
#
# Naming: Pydantic settings use `case_sensitive=False`, so `DATABASE_URL` and
# `database_url` are equivalent. This template uses UPPERCASE for clarity;
# backend/.env.example shows lowercase for the same keys — use either form.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend — required (matches backend/.env.example “core” block)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

SUPABASE_JWT_SECRET=your-supabase-jwt-secret

OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Backend — Supabase storage (assistant audio; matches backend/.env.example)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET="patient audio files"

ASSISTANT_AUDIO_TTL_SECONDS=604800
ASSISTANT_AUDIO_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Backend — paths & public URL (matches backend/.env.example)
# -----------------------------------------------------------------------------
LOCAL_STORAGE_PATH=./storage
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend — legacy JWT (matches backend/.env.example)
# -----------------------------------------------------------------------------
SECRET_KEY=dev-super-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Backend — CORS (env name is CORS_ORIGINS in code; optional in backend/.env.example comments)
# -----------------------------------------------------------------------------
# Include every browser origin that calls the API (Docker SPA default: port 8080).
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# -----------------------------------------------------------------------------
# Backend — optional seed script credentials (matches backend/.env.example)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASS=admin123

# -----------------------------------------------------------------------------
# Frontend — build-time (same keys as frontend/.env.example; Docker bakes these in)
# -----------------------------------------------------------------------------
# IMPORTANT: Changing any VITE_* value requires rebuilding the frontend image:
#   docker compose build frontend --no-cache
#   (or `docker compose build` to rebuild all services)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# Backend — optional: migrations at container start (Docker entrypoint only)
# -----------------------------------------------------------------------------
# RUN_MIGRATIONS=1
# Set RUN_MIGRATIONS=0 when running multiple API replicas; run Alembic as a one-off job.

# -----------------------------------------------------------------------------
# Backend — optional: app / LLM / plugins (defaults exist in code)
# -----------------------------------------------------------------------------
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# AUDIO_CACHE_PATH=./storage/cache/audio
# AUDIO_CACHE_MAX_BYTES=536870912
# DEFAULT_LLM_PROVIDER=openai
# OPENAI_MODEL_ID=gpt-4
# GEMINI_MODEL_ID=gemini-pro
# TTS_PROVIDER=openai
# ASR_PROVIDER=whisper
# RESEARCH_ANON_SALT=change-in-production
# Safe default for Item 1 research evaluations. Live hybrid/experimental runs
# also require an explicit allow_live=true request from an administrator.
RESEARCH_ALLOW_LIVE_EVALUATIONS=false
