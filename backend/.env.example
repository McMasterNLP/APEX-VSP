# --- core (required) ---
# Use your Supabase Postgres connection string (sslmode=require when Supabase requires SSL).
database_url=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# --- LLM ---
openai_api_key=your-openai-api-key
gemini_api_key=your-gemini-api-key
# Research evaluation runs are offline-only unless explicitly enabled here and
# in each authorized request.
research_allow_live_evaluations=false

# --- Supabase storage for assistant audio ---
supabase_url=https://your-project.supabase.co
supabase_service_role_key=your-service-role-key
supabase_storage_bucket="patient audio files"
assistant_audio_ttl_seconds=604800
assistant_audio_signed_url_ttl_seconds=3600

# --- Local media/cache paths ---
local_storage_path=./storage
public_base_url=http://localhost:8000

SECRET_KEY=dev-super-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase Auth (same as SUPABASE_JWT_SECRET / supabase_jwt_secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Initial seeded users (document these for teammates)
# Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASS=admin123

# Trainees (see seed script for list/passwords)

# CORS: use env name CORS_ORIGINS (JSON array or comma-separated), e.g.:
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# EACL demo seed script (scripts/seed_eacl_demo.py) -- only needed when running
# that script. Real Supabase Auth accounts only; see the script's docstring
# for the SQL to look up the UUIDs. Never commit real values.
EACL_SEED_REVIEWER_EMAIL=
EACL_SEED_REVIEWER_SUPABASE_AUTH_ID=
EACL_SEED_LEARNER_EMAIL=
EACL_SEED_LEARNER_SUPABASE_AUTH_ID=

# Usage guardrails (optional -- sane defaults in config/settings.py apply if unset)
# USAGE_DAILY_CHAT_TURN_LIMIT_PER_USER=100
# USAGE_DAILY_AUDIO_LIMIT_PER_USER=20
# USAGE_DAILY_LIVE_EVALUATION_LIMIT_PER_USER=20
# USAGE_DAILY_CHAT_TURN_LIMIT_GLOBAL=1000
# USAGE_DAILY_AUDIO_LIMIT_GLOBAL=300
# USAGE_DAILY_LIVE_EVALUATION_LIMIT_GLOBAL=150
